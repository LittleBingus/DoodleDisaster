local D = require(script.Parent.Parent.Deps)
local SkipVote = D.SkipVote

return function(t)
	t.test("majority thresholds", function()
		t.eq(SkipVote.needed(1), 1)
		t.eq(SkipVote.needed(2), 2)
		t.eq(SkipVote.needed(3), 2)
		t.eq(SkipVote.needed(4), 3)
		t.eq(SkipVote.needed(8), 5)
	end)

	t.test("one player cannot skip for a group", function()
		local v = SkipVote.new()
		t.truthy(v:cast("Entry", 1))
		t.falsy(v:passed("Entry", { 1, 2, 3 }))
		t.truthy(v:cast("Entry", 2))
		t.truthy(v:passed("Entry", { 1, 2, 3 }))
	end)

	t.test("duplicate, unknown-scope and non-eligible votes do not count", function()
		local v = SkipVote.new()
		t.truthy(v:cast("Entry", 1))
		t.falsy(v:cast("Entry", 1), "duplicate")
		t.falsy(v:cast("Everything", 1), "unknown scope")
		t.falsy(v:cast(nil, 1))
		v:cast("Entry", 99) -- spectator
		t.eq(v:count("Entry", { 1, 2, 3 }), 1)
		t.falsy(v:passed("Entry", { 1, 2, 3 }))
	end)

	t.test("a leaver's vote stops counting and the threshold follows the group", function()
		local v = SkipVote.new()
		v:cast("Book", 1)
		v:cast("Book", 2)
		t.falsy(v:passed("Book", { 1, 2, 3, 4 }), "2 of 4 is not a majority")
		t.truthy(v:passed("Book", { 1, 2, 3 }), "2 of 3 after one player leaves")
		t.falsy(v:passed("Book", { 2, 3, 4 }), "voter 1 left")
		t.falsy(v:passed("Book", {}), "nobody eligible")
	end)

	t.test("scopes are independent and reset", function()
		local v = SkipVote.new()
		v:cast("Entry", 1)
		t.eq(v:count("Book", { 1 }), 0)
		v:reset("Entry")
		t.eq(v:count("Entry", { 1 }), 0)
		t.truthy(v:cast("Entry", 1), "can vote again after reset")
	end)
end
